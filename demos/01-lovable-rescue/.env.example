# Copy to .env.local and fill in. Never commit real values.

# "local"    -> offline demo, data in localStorage, fake auth (default when Supabase vars are missing)
# "supabase" -> real backend
VITE_DATA_MODE=local

# Project URL and the PUBLIC anon / publishable key (Project Settings -> API).
# NEVER put the service_role / secret key here: every VITE_* variable ends up in the browser bundle.
# The app refuses to start if it detects a service_role key (see src/lib/supabaseClient.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
