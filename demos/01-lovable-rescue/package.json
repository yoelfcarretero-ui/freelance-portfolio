{
  "name": "slotbook",
  "private": true,
  "version": "1.0.0",
  "description": "SlotBook - appointment booking for a hair salon. A rescued Lovable-style React + Supabase app.",
  "type": "module",
  "author": "Yoel Carretero <yoelf.carretero@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "screenshots": "node scripts/screenshots.mjs",
    "verify:db": "bash scripts/verify-db.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.72.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
