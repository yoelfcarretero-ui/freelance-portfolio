# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# DEMO_MODE=true  -> fully offline: BM25 retrieval over a local index + extractive answers. Free.
# DEMO_MODE=false -> real RAG: OpenAI embeddings + Supabase pgvector + an LLM (Claude by default).
# If DEMO_MODE is unset, the app uses live mode only when all required keys below are present.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# LLM (server side only - never expose these to the browser)
# ---------------------------------------------------------------------------
# anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=
# Required in live mode for embeddings (and for chat if LLM_PROVIDER=openai)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Supabase (service role key is SECRET: server only, bypasses RLS)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Retrieval tuning (live mode)
# ---------------------------------------------------------------------------
MATCH_COUNT=4
MATCH_THRESHOLD=0.3

# ---------------------------------------------------------------------------
# Leads
# ---------------------------------------------------------------------------
# Optional: POST each new lead as JSON to this URL (Slack/Make/Zapier/n8n webhook)
LEAD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Comma-separated list of sites allowed to embed the widget. "*" = any (fine for the demo).
ALLOWED_ORIGINS=*
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_LEAD_PER_MIN=5

# Local dev server port
PORT=3000
