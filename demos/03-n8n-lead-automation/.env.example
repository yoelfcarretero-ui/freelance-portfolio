# Copy to .env and adjust. Never commit the real .env file.

# n8n image tag (pinned; bump deliberately after reading the release notes)
N8N_VERSION=2.47.7

# Host port for the editor and webhooks
N8N_PORT=5678

# Timezone used by Schedule triggers and date expressions
GENERIC_TIMEZONE=Europe/Madrid

# Public URL n8n uses to build webhook URLs. Change it when running behind a domain/reverse proxy,
# e.g. https://n8n.example.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Set to true when served over HTTPS
N8N_SECURE_COOKIE=false

# Encryption key for stored credentials. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: losing it means losing access to every saved credential.
# Leave it commented out locally and n8n will generate one inside the volume.
# N8N_ENCRYPTION_KEY=
