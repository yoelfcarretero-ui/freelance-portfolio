{
  "id": "InboxDigestWf001",
  "name": "Daily Inbox Digest (AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
