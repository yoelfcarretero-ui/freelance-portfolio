    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalize and validate the incoming lead. Runs once per item.\n// The Webhook node puts the POST payload under $json.body.\nconst body = $json.body ?? $json;\n\nconst clean = (value, max = 500) =>\n  String(value ?? '').trim().replace(/\\s+/g, ' ').slice(0, max);\n\nconst lead = {\n  name: clean(body.name, 120),\n  email: clean(body.email, 200).toLowerCase(),\n  company: clean(body.company, 160),\n  phone: clean(body.phone, 40).replace(/[^\\d+]/g, ''),\n  source: clean(body.source || 'website-form', 60),\n  message: String(body.message ?? '').trim().slice(0, 4000),\n};\n\nconst errors = [];\nif (lead.name.length < 2) errors.push('name is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(lead.email)) errors.push('email is invalid');\nif (lead.message.length < 10) errors.push('message must be at least 10 characters');\n// Honeypot: the form has a hidden \"website\" field that only bots fill in.\nif (clean(body.website)) errors.push('spam detected');\n\nlead.lead_id = 'L-' + $now.toFormat('yyyyMMdd-HHmmss') + '-' + Math.random().toString(36).slice(2, 6);\nlead.received_at = $now.toISO();\n\nreturn { json: { ...lead, valid: errors.length === 0, errors } };"
      },
      "id": "a367dc7b-5468-4b6c-9478-d6da212b50ca",
      "name": "Normalize & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
