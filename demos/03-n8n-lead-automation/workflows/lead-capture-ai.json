    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Combine the normalized lead with the AI classification (the parser puts it under \"output\").\nconst lead = $('Normalize & Validate').item.json;\nconst ai = $json.output ?? {};\nreturn {\n  json: {\n    lead_id: lead.lead_id,\n    received_at: lead.received_at,\n    name: lead.name,\n    email: lead.email,\n    company: lead.company,\n    phone: lead.phone,\n    source: lead.source,\n    message: lead.message,\n    category: ai.category ?? 'other',\n    urgency: ai.urgency ?? 'medium',\n    budget_estimate: ai.budget_estimate ?? 'unknown',\n    summary: ai.summary ?? '',\n    suggested_reply: ai.suggested_reply ?? '',\n    classified_by: 'llm',\n  },\n};"
      },
